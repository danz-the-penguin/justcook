datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model PantryItem {
  id           String            @id @default(cuid())
  slug         String            @unique
  name         String
  category     String            // "dairy", "produce", "meat", "pantry", "spices"
  defaultUnit  String            // "piece", "g", "ml", "tbsp", etc.
  pngAsset     String            // Path to transparent PNG: e.g. "/assets/food/egg.png"
  displayLimit Int               @default(12)
  batches      PantryItemBatch[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model PantryItemBatch {
  id           String      @id @default(cuid())
  pantryItemId String
  pantryItem   PantryItem  @relation(fields: [pantryItemId], references: [id], onDelete: Cascade)
  quantity     Float
  unit         String
  obtainedAt   DateTime    @default(now())
  expiresAt    DateTime
  location     String      // "fridge", "freezer", "pantry", "counter"
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Recipe {
  id              String             @id @default(cuid())
  title           String
  description     String?
  source          String             @default("custom") // "custom", "seeded", "themealdb"
  externalId      String?
  prepTimeMinutes Int                @default(10)
  cookTimeMinutes Int                @default(15)
  servings        Int                @default(2)
  instructions    String             // JSON string array of step instructions
  imageUrl        String?
  tags            String?            // Comma-separated tags, e.g. "Breakfast,Quick,High-Protein"
  ingredients     RecipeIngredient[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

model RecipeIngredient {
  id         String   @id @default(cuid())
  recipeId   String
  recipe     Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  name       String   // Normalized name (e.g. "egg", "milk")
  rawText    String   // Original text (e.g. "2 large eggs, beaten")
  amount     Float
  unit       String
  category   String   @default("produce")
  isOptional Boolean  @default(false)
}

model RescuedStat {
  id                    String   @id @default(cuid())
  itemName              String
  quantity              Float
  unit                  String
  rescuedAt             DateTime @default(now())
  recipeTitle           String?
  savedDaysBeforeExpiry Int?
  estimatedValue        Float    @default(1.50) // in $
}

model ShoppingItem {
  id           String   @id @default(cuid())
  name         String
  amount       Float?
  unit         String?
  category     String   @default("produce")
  isChecked    Boolean  @default(false)
  sourceRecipe String?
  createdAt    DateTime @default(now())
}
